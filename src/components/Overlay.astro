---
// Full-screen layer for the page transition. It persists across page swaps so
// the animation plays on through the navigation (see scripts/overlay.ts).
---

<div data-ov data-morph-skip aria-hidden="true" transition:persist="fario-overlay" style="position:fixed;inset:0;z-index:60;visibility:hidden;pointer-events:none">
  <div data-ov-box style="position:absolute;inset:0"></div>
  <div data-ov-text style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;opacity:0;pointer-events:none;text-align:center">
    <span data-ov-num style="font-family:'Martian Mono',monospace;font-size:12px;letter-spacing:.16em;color:#a9b8ae"></span>
    <span data-ov-label style="font-family:'Sofia Sans Extra Condensed',sans-serif;font-weight:900;font-size:clamp(84px,15vw,260px);line-height:.8;letter-spacing:-.01em;text-transform:uppercase;color:#d2f25c"></span>
  </div>
</div>
